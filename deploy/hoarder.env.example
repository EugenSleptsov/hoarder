# Copy to the deployment directory as .env with mode 0600. Secrets stay in files.
HOARDER_CHAT_ID=YOUR_NUMERIC_PRIVATE_CHAT_ID
TELEGRAM_BOT_TOKEN_FILE=/absolute/private/path/telegram-token
HOARDER_DB=/absolute/private/path/hoarder.db
HOARDER_TIMEZONE=Europe/Berlin
HOARDER_POLL_TIME=21:00
HOARDER_CATCH_UP=30m
# Optional agent endpoint; loopback only.
HOARDER_MCP_ADDR=127.0.0.1:8765
HOARDER_MCP_TOKEN_FILE=/absolute/private/path/mcp-token
